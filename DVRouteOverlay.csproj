<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>DVRouteOverlay</AssemblyName>
    <RootNamespace>DVRouteOverlay</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.3.2</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <GamePath Condition="'$(GamePath)' == ''">/home/deck/.local/share/Steam/steamapps/common/Derail Valley</GamePath>
    <FrameworkPathOverride>$(GamePath)/DerailValley_Data/Managed</FrameworkPathOverride>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Reference Include="Assembly-CSharp"><HintPath>$(GamePath)/DerailValley_Data/Managed/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="DV.RailTrack"><HintPath>$(GamePath)/DerailValley_Data/Managed/DV.RailTrack.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="DV.PointSet"><HintPath>$(GamePath)/DerailValley_Data/Managed/DV.PointSet.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="net.smkd.vector3d"><HintPath>$(GamePath)/DerailValley_Data/Managed/net.smkd.vector3d.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="DV.Utils"><HintPath>$(GamePath)/DerailValley_Data/Managed/DV.Utils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BezierCurves"><HintPath>$(GamePath)/DerailValley_Data/Managed/BezierCurves.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GamePath)/DerailValley_Data/Managed/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GamePath)/DerailValley_Data/Managed/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GamePath)/DerailValley_Data/Managed/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GamePath)/DerailValley_Data/Managed/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(GamePath)/DerailValley_Data/Managed/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GamePath)/DerailValley_Data/Managed/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityModManager"><HintPath>$(GamePath)/DerailValley_Data/Managed/UnityModManager/UnityModManager.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
